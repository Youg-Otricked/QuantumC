void __qc_reverse(char* str, int length) {
    int left = 0;
    int right = length - 1;
    while (left < right)
    {
        char temp = str[left];
        str[left] = str[right];
        str[right] = temp;

        left++;
        right--;
    }
}
string __qc_to_string_long_int_helper(long int x) {
    char buf[64];
    int index = 0;
    bool negative = x < 0;
    addr_t value;
    if (negative) {
        value = -x;
    } else {
        value = x;
    }
    if (value == 0) {
        buf[index++] = '0';
    } else {
        while (value != 0) {
            int digit = value % 10;
            buf[index++] = '0' + digit;
            value /= 10;
        }
    }
    if (negative) {
        buf[index++] = '-';
    }
    __qc_reverse(buf, index);
    char* output = __qc_malloc(index + 1);
    if (!output) return nullptr;
    __qc_memcpy(output, buf, index);
    output[index] = '\0';
    return output;
}
