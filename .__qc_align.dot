digraph "CFG for '__qc_align' function" {
	label="CFG for '__qc_align' function";

	Node0x562fc78328c0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %size1 = alloca i64, align 8\l  store i64 %size, ptr %size1, align 8\l  %size2 = load i64, ptr %size1, align 8\l  %ALIGNMENT = load i32, ptr @ALIGNMENT, align 4\l  %promote_int = sext i32 %ALIGNMENT to i64\l  %add = add i64 %size2, %promote_int\l  %sub = sub i64 %add, 1\l  %ALIGNMENT3 = load i32, ptr @ALIGNMENT, align 4\l  %sub4 = sub i32 %ALIGNMENT3, 1\l  %nottmp = xor i32 %sub4, -1\l  %promote_int5 = sext i32 %nottmp to i64\l  %andtmp = and i64 %sub, %promote_int5\l  ret i64 %andtmp\l}"];
