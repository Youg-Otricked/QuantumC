	Node0x562fc799db10 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %seed1 = alloca i64, align 8\l  store i64 %seed, ptr %seed1, align 8\l  %assign_lhs_val = load i64, ptr @__qc_current_seed, align 8\l  %seed2 = load i64, ptr %seed1, align 8\l  store i64 %seed2, ptr @__qc_current_seed, align 8\l  %assign_lhs_val3 = load i64, ptr @__qc_s0, align 8\l  %seed4 = load i64, ptr %seed1, align 8\l  %calltmp = call i64 @__qc_splitmix(ptr %seed1)\l  store i64 %calltmp, ptr @__qc_s0, align 8\l  %assign_lhs_val5 = load i64, ptr @__qc_s1, align 8\l  %seed6 = load i64, ptr %seed1, align 8\l  %calltmp7 = call i64 @__qc_splitmix(ptr %seed1)\l  store i64 %calltmp7, ptr @__qc_s1, align 8\l  %assign_lhs_val8 = load i64, ptr @__qc_s2, align 8\l  %seed9 = load i64, ptr %seed1, align 8\l  %calltmp10 = call i64 @__qc_splitmix(ptr %seed1)\l  store i64 %calltmp10, ptr @__qc_s2, align 8\l  %assign_lhs_val11 = load i64, ptr @__qc_s3, align 8\l  %seed12 = load i64, ptr %seed1, align 8\l  %calltmp13 = call i64 @__qc_splitmix(ptr %seed1)\l  store i64 %calltmp13, ptr @__qc_s3, align 8\l  ret void\l}"];
